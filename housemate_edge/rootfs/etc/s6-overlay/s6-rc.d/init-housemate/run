#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Housemate: prepare the add-on's state and write OpenCode's provider config.
#
# The key is read by jq straight from the options file into OpenCode's config:
# it is never put in a shell variable, an argument, an environment variable or
# a log line.
# ==============================================================================
set -o errexit -o nounset -o pipefail

readonly options="/data/options.json"
readonly config_dir="${XDG_CONFIG_HOME}/opencode"
readonly config_file="${config_dir}/opencode.json"

# A new id at every start of the container: the panel's page reloads itself when
# it sees it change (web/reconnect.js). Readable by nginx, which is not root.
cat /proc/sys/kernel/random/uuid > /run/housemate-boot-id
chmod 644 /run/housemate-boot-id

umask 077
mkdir -p \
    "${config_dir}" \
    "${XDG_DATA_HOME}" \
    "${XDG_STATE_HOME}" \
    "${XDG_CACHE_HOME}" \
    /data/code-server/extensions \
    /data/code-server/User \
    /data/code-server/Machine

# Built-in rules: part of the image, replaced on every start so that they
# update with every release. The user's own AGENTS.md lives in /config.
cp /usr/share/housemate/AGENTS.md "${config_dir}/AGENTS.md"

# Built-in skills, replaced on every start like the rules above: the incoming
# review must work even if the user has changed every file of their own kit.
mkdir -p "${config_dir}/skills"
for skill in /usr/share/housemate/skills/*/; do
    name=$(basename "${skill}")
    rm -rf "${config_dir:?}/skills/${name}"
    cp -r "${skill}" "${config_dir}/skills/${name}"
done

# code-server's first-start settings; after that they are the user's.
if [[ ! -f /data/code-server/User/settings.json ]]; then
    cp /usr/share/housemate/code-server-settings.json /data/code-server/User/settings.json
elif ! grep -q 'workbench.colorTheme' /data/code-server/User/settings.json \
    && jq -e . /data/code-server/User/settings.json > /dev/null 2>&1; then
    # An add-on from before the dark default: a settings file that never named a
    # theme gets the default once. A theme the user has chosen is never touched.
    jq '. + {"workbench.colorTheme": "Default Dark Modern"}' /data/code-server/User/settings.json > /data/code-server/User/settings.json.tmp \
        && mv /data/code-server/User/settings.json.tmp /data/code-server/User/settings.json
fi

# code-server's machine settings: the add-on's own defaults (VS Code's built-in
# chat hidden, so that Housemate's agent is the only one on screen). They sit
# above the user's settings.json, are replaced on every start and so update with
# every release; the user's file is left alone.
cp /usr/share/housemate/code-server-machine-settings.json /data/code-server/Machine/settings.json

# The sidebar entry: config.yaml's ingress_panel is ignored by the Supervisor, so
# on the very first start the add-on switches its own panel on through the
# Supervisor API, and records that under /data. After that it never touches the
# setting again: a user who hides the panel keeps their choice. If the call
# fails nothing is recorded, and the next start tries again.
readonly sidebar_done="/data/.housemate-sidebar-done"
if [[ ! -e "${sidebar_done}" ]]; then
    if curl -fsS --max-time 20 -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d '{"ingress_panel": true}' \
        http://supervisor/addons/self/options > /dev/null; then
        touch "${sidebar_done}"
        bashio::log.info "Housemate is now shown in the sidebar (switch it off on the add-on's Info page if you prefer)."
    else
        bashio::log.warning "Could not show Housemate in the sidebar; it will try again at the next start."
    fi
fi

# The starter kit: copied into /config on the very first start only.
/usr/share/housemate/seed-kit
if [[ -f /config/.housemate/incoming/manifest.json ]]; then
    bashio::log.info "Kit changes are waiting in /config/.housemate/incoming; ask the agent to review them."
fi

provider=$(jq -r '.provider // "go"' "${options}")
case "${provider}" in
    go) provider_id="opencode-go"; default_model="opencode-go/deepseek-v4.1-flash" ;;
    zen) provider_id="opencode"; default_model="opencode/deepseek-v4.1-flash-free" ;;
    openai-compatible)
        provider_id="openai-compatible"
        default_model=""
        # No default here: the add-on cannot know what the endpoint serves. Say
        # what is missing, never the key.
        base_url=$(jq -r '(.base_url // "") | gsub("^\\s+|\\s+$"; "") | sub("/+$"; "")' "${options}")
        model_id=$(jq -r '(.model // "") | gsub("^\\s+|\\s+$"; "")' "${options}")
        if [[ -z "${base_url}" ]]; then
            bashio::exit.nok "Provider openai-compatible needs a base_url (for example https://openrouter.ai/api/v1): set it in the Configuration tab."
        fi
        if [[ "${base_url}" != http://* && "${base_url}" != https://* ]]; then
            bashio::exit.nok "base_url must start with http:// or https://."
        fi
        if [[ -z "${model_id}" ]]; then
            bashio::exit.nok "Provider openai-compatible needs a model (the model id the endpoint expects): set it in the Configuration tab."
        fi
        ;;
    *) bashio::exit.nok "Unknown provider '${provider}': choose go, zen or openai-compatible." ;;
esac

# OpenCode's provider config. With no key, only the provider is selected.
# The permission lets OpenCode read the add-on's own files (the built-in rules,
# skills and the kit's how-tos under /usr/share/housemate) without asking, because
# they lie outside the /config workspace. Nothing else is widened: writes keep
# their defaults.
jq --arg id "${provider_id}" --arg default_model "${default_model}" --arg provider "${provider}" '
    {
        "$schema": "https://opencode.ai/config.json",
        autoupdate: false,
        enabled_providers: [$id],
        model: (if $provider == "openai-compatible"
                then $id + "/" + (.model | gsub("^\\s+|\\s+$"; ""))
                elif ((.model // "") | length) > 0 then .model
                else $default_model end),
        permission: {
            external_directory: {
                "/usr/share/housemate/**": "allow"
            }
        }
    }
    + (if $provider == "openai-compatible"
        # A custom provider: OpenCode ships @ai-sdk/openai-compatible inside its
        # binary, so nothing is fetched at run time. The model id may contain
        # slashes (OpenRouter), so it is the key as it stands.
        then {provider: {($id): {
            npm: "@ai-sdk/openai-compatible",
            name: "OpenAI-compatible endpoint",
            options: ({baseURL: (.base_url | gsub("^\\s+|\\s+$"; "") | sub("/+$"; ""))}
                      + (if ((.api_key // "") | gsub("^\\s+|\\s+$"; "") | length) > 0 then {apiKey: (.api_key | gsub("^\\s+|\\s+$"; ""))} else {} end)),
            models: {((.model | gsub("^\\s+|\\s+$"; ""))): {name: (.model | gsub("^\\s+|\\s+$"; ""))}}
        }}}
        elif ((.api_key // "") | gsub("^\\s+|\\s+$"; "") | length) > 0
        then {provider: {($id): {options: {apiKey: (.api_key | gsub("^\\s+|\\s+$"; ""))}}}}
        else {} end)
' "${options}" > "${config_file}.tmp"
chmod 600 "${config_file}.tmp"
mv "${config_file}.tmp" "${config_file}"

# bashio keeps a copy of the options (the key among them) in /tmp while the
# base image's own steps read them. Nothing needs it after that: remove it.
rm -rf /tmp/.bashio

if jq -e '(.api_key // "") | gsub("^\\s+|\\s+$"; "") | length > 0' "${options}" > /dev/null; then
    bashio::log.info "OpenCode provider '${provider_id}' configured with a key."
elif [[ "${provider}" == "openai-compatible" ]]; then
    bashio::log.info "OpenCode provider '${provider_id}' configured without a key (fine for a local server)."
elif [[ "${provider}" == "zen" ]]; then
    bashio::log.info "OpenCode provider '${provider_id}' runs without a key (Zen's free models need none; a paid model needs one in the Configuration tab)."
else
    bashio::log.warning "OpenCode provider '${provider_id}' has no key; set one in the Configuration tab."
fi
